# The app calls /api on its own origin, and the host forwards that to the API
# server — vercel.json in production, src/setupProxy.js on the dev server.
# That keeps the session cookie first-party, which is what keeps it working in
# browsers that block third-party cookies. Leave this unset for that setup.
#
# Setting it points the app straight at another domain instead. The API then
# needs COOKIE_SAMESITE=none, COOKIE_SECURE=true and this origin in
# CORS_ORIGIN — and the session will still break in browsers that refuse
# third-party cookies. Prefer the proxy.
# REACT_APP_BACKEND_URL=https://your-api.vercel.app

# Where the dev-server proxy forwards /api. Defaults to http://localhost:5000.
# DEV_API_URL=http://localhost:5000
